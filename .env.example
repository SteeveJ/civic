# Copie ce fichier en .env et remplis ce qui te sert. Tout est facultatif.

# Clé API Anthropic. Vide : l'app passe par le compte Claude connecté en local (commande `claude`).
ANTHROPIC_API_KEY=

# Modèle utilisé.
MODEL=claude-haiku-5-5

# Port du serveur web.
PORT=3000

# Nombre de requêtes par IP et par jour.
DAILY_LIMIT=100

# 1 si l'app tourne derrière un reverse proxy (Nginx, Caddy…), pour compter les vraies IP.
TRUST_PROXY=0

# Interpréteur Python pour le nettoyage des filigranes invisibles.
PYTHON=python3
